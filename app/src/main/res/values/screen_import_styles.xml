<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keeps ScreenImportActivity transparent so its bottom-sheet dialog overlays the existing screen. -->
    <style name="Theme.SketchwarePro.ScreenImportOverlay" parent="Theme.SketchwarePro">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SketchwarePro.BottomSheetDialog</item>
    </style>
</resources>
