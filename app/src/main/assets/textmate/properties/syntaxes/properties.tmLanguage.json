{
  "name": "Properties",
  "scopeName": "source.ini",
  "fileTypes": ["properties", "ini", "cfg", "conf", "env"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#section" },
    { "include": "#key-value" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "match": "^\\s*#.*$",  "name": "comment" },
        { "match": "^\\s*;.*$",  "name": "comment" },
        { "match": "\\s#[^\\n]*", "name": "comment" }
      ]
    },
    "section": {
      "match": "^\\s*(\\[)([^\\]]*)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.section.begin"  },
        "2": { "name": "entity.name.type"                      },
        "3": { "name": "punctuation.definition.section.end"    }
      }
    },
    "key-value": {
      "patterns": [
        {
          "match": "^\\s*([^=:\\s][^=:\\n]*?)\\s*([=:])\\s*(.*?)\\s*$",
          "captures": {
            "1": { "name": "support.type.property-name" },
            "2": { "name": "keyword.operator" },
            "3": { "name": "string.quoted.double" }
          }
        },
        {
          "match": "^\\s*([^=:\\s][^=:\\n]*?)\\s*$",
          "captures": { "1": { "name": "support.type.property-name" } }
        }
      ]
    }
  }
}
