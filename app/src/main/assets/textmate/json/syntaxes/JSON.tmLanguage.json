{
  "name": "JSON",
  "scopeName": "source.json",
  "fileTypes": ["json"],
  "patterns": [{ "include": "#value" }],
  "repository": {
    "value": {
      "patterns": [
        { "include": "#constant" },
        { "include": "#number"   },
        { "include": "#string"   },
        { "include": "#array"    },
        { "include": "#object"   },
        { "include": "#comment"  }
      ]
    },
    "constant": {
      "match": "\\b(?:true|false|null)\\b",
      "name": "constant.language"
    },
    "number": {
      "match": "-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end" } },
      "name": "string.quoted.double",
      "patterns": [{ "include": "#escape" }]
    },
    "object-key": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end" } },
      "name": "string.quoted.double support.type.property-name",
      "patterns": [{ "include": "#escape" }]
    },
    "escape": {
      "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})",
      "name": "constant.character.escape"
    },
    "array": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.definition.array.begin" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.array.end" } },
      "name": "meta.structure.array",
      "patterns": [
        { "include": "#value" },
        { "match": ",", "name": "punctuation.separator.array" }
      ]
    },
    "object": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.dictionary.begin" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.dictionary.end" } },
      "name": "meta.structure.dictionary",
      "patterns": [
        { "include": "#object-key" },
        { "match": ":", "name": "punctuation.separator.key-value" },
        { "include": "#value" },
        { "match": ",", "name": "punctuation.separator.object" }
      ]
    },
    "comment": {
      "patterns": [
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block" },
        { "match": "//.*$",              "name": "comment" }
      ]
    }
  }
}
