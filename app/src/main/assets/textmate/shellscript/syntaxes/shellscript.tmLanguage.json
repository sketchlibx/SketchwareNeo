{
  "name": "Shell Script",
  "scopeName": "source.shell",
  "fileTypes": ["sh", "bash", "zsh", "fish"],
  "firstLineMatch": "^#!.*(?:bash|sh|zsh)\\b",
  "patterns": [
    { "include": "#shebang"         },
    { "include": "#comment"         },
    { "include": "#string-double"   },
    { "include": "#string-single"   },
    { "include": "#heredoc"         },
    { "include": "#variable"        },
    { "include": "#keyword"         },
    { "include": "#builtin"         },
    { "include": "#number"          },
    { "include": "#operator"        }
  ],
  "repository": {
    "shebang": {
      "match": "^(#!)(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.comment" },
        "2": { "name": "comment" }
      }
    },
    "comment": {
      "match": "(?<!['\"`])#.*$",
      "name": "comment"
    },
    "string-double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double",
      "patterns": [
        { "include": "#variable" },
        { "include": "#command-substitution" },
        { "match": "\\\\(?:[nrtbf\\\\\"$`])", "name": "constant.character.escape" }
      ]
    },
    "string-single": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single"
    },
    "heredoc": {
      "begin": "<<-?\\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\\1",
      "end": "^\\s*\\2$",
      "name": "string.unquoted.heredoc",
      "patterns": [{ "include": "#variable" }]
    },
    "variable": {
      "patterns": [
        {
          "begin": "\\$\\{",
          "end": "\\}",
          "name": "variable.other",
          "patterns": [
            { "match": "[^}]+", "name": "variable.other" }
          ]
        },
        { "match": "\\$(?:[0-9#@*?!$-]|[a-zA-Z_][a-zA-Z0-9_]*)", "name": "variable.other" },
        { "match": "\\$\\(\\(.*?\\)\\)",  "name": "variable.other" }
      ]
    },
    "command-substitution": {
      "patterns": [
        { "begin": "`", "end": "`", "name": "meta.embedded", "patterns": [{ "include": "$self" }] },
        { "begin": "\\$\\(", "end": "\\)", "name": "meta.embedded", "patterns": [{ "include": "$self" }] }
      ]
    },
    "keyword": {
      "match": "\\b(if|then|else|elif|fi|for|in|do|done|while|until|case|esac|select|function|return|exit|break|continue|shift|set|unset|export|local|declare|readonly|typeset|eval|exec|source|trap|wait|true|false|test|time)\\b",
      "name": "keyword"
    },
    "builtin": {
      "match": "\\b(echo|printf|read|cd|ls|pwd|mkdir|rmdir|rm|cp|mv|cat|grep|sed|awk|cut|sort|uniq|head|tail|wc|find|xargs|chmod|chown|ln|touch|date|sleep|kill|ps|env|which|type|hash|alias|unalias|getopts|let|expr|basename|dirname|realpath|readlink|stat|file|tar|gzip|gunzip|zip|unzip|curl|wget|git|make|cmake|ninja|clang|clang\\+\\+|gcc|g\\+\\+|adb|android|ndk-build|gradlew)\\b",
      "name": "support.function"
    },
    "number": {
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b",
      "name": "constant.numeric"
    },
    "operator": {
      "match": "(?:&&|\\|\\||;;|>>|<<|[|&;><]|[=!]=|[<>]=?)",
      "name": "keyword.operator"
    }
  }
}
