{
  "name": "CMake",
  "scopeName": "source.cmake",
  "fileTypes": ["cmake", "CMakeLists"],
  "firstLineMatch": "^cmake_minimum_required",
  "patterns": [
    { "include": "#comment"   },
    { "include": "#command"   },
    { "include": "#variable"  },
    { "include": "#string"    },
    { "include": "#keyword"   },
    { "include": "#number"    },
    { "include": "#generator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "begin": "#\\[\\[", "end": "\\]\\]", "name": "comment.block" },
        { "match": "#.*$",                     "name": "comment"        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "begin": "\\$\\{",
          "end": "\\}",
          "name": "variable.other",
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other" }
          ]
        },
        {
          "begin": "\\$ENV\\{",
          "end": "\\}",
          "name": "variable.other",
          "patterns": [{ "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other" }]
        },
        {
          "begin": "\\$CACHE\\{",
          "end": "\\}",
          "name": "variable.other",
          "patterns": [{ "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other" }]
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double",
      "patterns": [
        { "include": "#variable" },
        { "match": "\\\\(?:[nrtbf\"\\\\]|;)", "name": "constant.character.escape" }
      ]
    },
    "command": {
      "match": "(?i)\\b(cmake_minimum_required|project|add_library|add_executable|target_link_libraries|target_include_directories|target_sources|target_compile_options|target_compile_definitions|target_compile_features|target_precompile_headers|set_target_properties|get_target_property|find_library|find_package|find_path|find_file|find_program|include|include_directories|link_directories|link_libraries|add_subdirectory|add_custom_command|add_custom_target|add_definitions|add_compile_options|add_compile_definitions|set|unset|get_property|set_property|option|file|configure_file|install|enable_testing|add_test|message|cmake_parse_arguments|list|string|math|execute_process|if|elseif|else|endif|foreach|endforeach|while|endwhile|function|endfunction|macro|endmacro|return|break|continue|cmake_policy|cmake_path|block|endblock|source_group|target_link_options|target_link_directories|check_c_compiler_flag|check_cxx_compiler_flag|check_include_file|check_symbol_exists|include_guard|cmake_host_system_information|cmake_system_information|set_source_files_properties|get_source_file_property|define_property|get_directory_property|set_directory_properties|cmake_print_variables|cmake_print_properties)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function" } }
    },
    "keyword": {
      "match": "(?i)\\b(TRUE|FALSE|ON|OFF|YES|NO|AND|OR|NOT|STREQUAL|STRLESS|STRGREATER|EQUAL|LESS|GREATER|LESS_EQUAL|GREATER_EQUAL|MATCHES|EXISTS|IS_DIRECTORY|IS_SYMLINK|IS_ABSOLUTE|DEFINED|CACHE|PARENT_SCOPE|FORCE|MODULE|SHARED|STATIC|OBJECT|INTERFACE|IMPORTED|ALIAS|EXCLUDE_FROM_ALL|PUBLIC|PRIVATE|INTERFACE|REQUIRED|QUIET|HINTS|PATHS|NO_DEFAULT_PATH|OPTIONAL|SEND_ERROR|STATUS|WARNING|AUTHOR_WARNING|DEPRECATION|VERBOSE|DEBUG|TRACE|FATAL_ERROR|GLOB|GLOB_RECURSE|RECURSE|APPEND|PREPEND|REMOVE|REPLACE|WRITE|READ|STRINGS|TIMESTAMP|DOWNLOAD|UPLOAD|COPY|INSTALL|RENAME|REMOVE_RECURSE|MAKE_DIRECTORY|CREATE_LINK|GENERATE|CONFIGURE)\\b",
      "name": "keyword"
    },
    "number": {
      "match": "\\b[0-9]+(?:\\.[0-9]+)*\\b",
      "name": "constant.numeric"
    },
    "generator": {
      "begin": "\\$<",
      "end": ">",
      "name": "meta.embedded",
      "patterns": [
        { "match": "[A-Za-z_][A-Za-z0-9_:,]*", "name": "support.function" }
      ]
    }
  }
}
