{
  "comments": { "lineComment": "//", "blockComment": ["/*","*/"] },
  "brackets": [["{","}"],["[","]"],["(",")"]],
  "autoClosingPairs": [
    ["{","}"],["[","]"],["(",")"],
    {"open":"\"","close":"\"","notIn":["string","comment"]},
    {"open":"'","close":"'","notIn":["string","comment"]},
    {"open":"/**","close":" */","notIn":["string"]}
  ],
  "surroundingPairs": [
    ["{","}"],["[","]"],["(",")"],["\"","\""],["'","'"]
  ],
  "folding": {
    "markers": { "start":"^\\s*#pragma\\s+region","end":"^\\s*#pragma\\s+endregion" }
  }
}
