{
  "name": "C",
  "scopeName": "source.c",
  "fileTypes": ["c"],
  "patterns": [
    { "include": "#preprocessor"  },
    { "include": "#comment"       },
    { "include": "#string"        },
    { "include": "#char-literal"  },
    { "include": "#keyword"       },
    { "include": "#storage-type"  },
    { "include": "#constant"      },
    { "include": "#number"        },
    { "include": "#function-call" },
    { "include": "#operator"      }
  ],
  "repository": {
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*include)\\s+(<[^>]*>)",
          "captures": {
            "1": { "name": "keyword.control.directive" },
            "2": { "name": "string.quoted.other" }
          }
        },
        {
          "match": "^\\s*(#\\s*include)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.directive" },
            "2": { "name": "string.quoted.double" }
          }
        },
        {
          "match": "^\\s*(#\\s*define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive" },
            "2": { "name": "entity.name.function" }
          }
        },
        {
          "match": "^\\s*(#\\s*(?:undef|ifdef|ifndef|if|elif|else|endif|error|pragma|warning|line))\\b",
          "captures": { "1": { "name": "keyword.control.directive" } }
        }
      ]
    },
    "comment": {
      "patterns": [
        { "begin": "/\\*\\*", "end": "\\*/", "name": "comment.block.documentation" },
        { "begin": "/\\*",    "end": "\\*/", "name": "comment.block"               },
        { "match": "//.*$",                  "name": "comment"                      }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double",
      "patterns": [{ "include": "#escape" }]
    },
    "char-literal": {
      "match": "'(?:[^'\\\\]|\\\\.)'",
      "name": "string.quoted.single"
    },
    "escape": {
      "match": "\\\\(?:[nrtbf0\\\\\"'?]|x[0-9a-fA-F]{1,2}|[0-7]{1,3})",
      "name": "constant.character.escape"
    },
    "keyword": {
      "match": "\\b(if|else|while|for|do|switch|case|break|continue|return|goto|default|sizeof|typedef|struct|union|enum|extern|static|const|volatile|inline|auto|register|restrict|_Bool|_Complex|_Imaginary|_Alignas|_Alignof|_Atomic|_Generic|_Noreturn|_Static_assert|_Thread_local)\\b",
      "name": "keyword"
    },
    "storage-type": {
      "match": "\\b(void|int|char|short|long|float|double|unsigned|signed|bool|size_t|ssize_t|ptrdiff_t|intptr_t|uintptr_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|intmax_t|uintmax_t|FILE|NULL|EOF)\\b",
      "name": "storage.type"
    },
    "constant": {
      "match": "\\b(NULL|TRUE|FALSE|true|false)\\b",
      "name": "constant.language"
    },
    "number": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+[uUlL]*|0[bB][01]+[uUlL]*|0[0-7]+[uUlL]*|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?[fFlLuU]*)\\b",
      "name": "constant.numeric"
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function" } }
    },
    "operator": {
      "match": "(?:->|\\+\\+|--|<<|>>|<=|>=|==|!=|&&|\\|\\||[+\\-*/%&|^~!<>=?:])",
      "name": "keyword.operator"
    }
  }
}
