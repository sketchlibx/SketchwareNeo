{
  "name": "Markdown",
  "scopeName": "text.html.markdown",
  "fileTypes": ["md", "markdown", "mkd", "mdown", "mkdn"],
  "patterns": [
    { "include": "#heading"         },
    { "include": "#blockquote"      },
    { "include": "#code-block"      },
    { "include": "#fenced-code"     },
    { "include": "#inline-code"     },
    { "include": "#hr"              },
    { "include": "#list"            },
    { "include": "#link"            },
    { "include": "#image"           },
    { "include": "#bold-italic"     },
    { "include": "#bold"            },
    { "include": "#italic"          },
    { "include": "#strikethrough"   },
    { "include": "#escape"          }
  ],
  "repository": {
    "heading": {
      "patterns": [
        { "match": "^(#{1,6})\\s+(.+?)\\s*(?:#*)\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.heading" },
            "2": { "name": "markup.heading" }
          }
        }
      ]
    },
    "blockquote": {
      "begin": "^>\\s?",
      "end": "^(?!>)",
      "name": "markup.quote",
      "patterns": [{ "include": "$self" }]
    },
    "code-block": {
      "match": "^(?:    |\\t)(.+)$",
      "captures": { "1": { "name": "string.quoted.double" } }
    },
    "fenced-code": {
      "patterns": [
        {
          "begin": "^(`{3,})\\s*(?:([a-zA-Z][a-zA-Z0-9+-]*))?\\s*$",
          "end": "^(`{3,})\\s*$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.raw" },
            "2": { "name": "entity.name.type" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.raw" } },
          "name": "markup.raw.block",
          "contentName": "string.quoted.double"
        },
        {
          "begin": "^(~{3,})\\s*(?:([a-zA-Z][a-zA-Z0-9+-]*))?\\s*$",
          "end": "^(~{3,})\\s*$",
          "name": "markup.raw.block",
          "contentName": "string.quoted.double"
        }
      ]
    },
    "inline-code": {
      "patterns": [
        { "match": "(`{2})([^`].*?[^`]|.?)\\1", "captures": { "2": { "name": "string.quoted.double" } } },
        { "match": "(`)[^`].*?\\1",              "captures": { "2": { "name": "string.quoted.double" } } }
      ]
    },
    "hr": {
      "match": "^(?:---[-]*|===\\=+|___[_]*)\\s*$",
      "name": "punctuation.definition.separator"
    },
    "list": {
      "patterns": [
        { "match": "^\\s*(?:-|\\*|\\+)\\s", "name": "punctuation.definition.list" },
        { "match": "^\\s*\\d+\\.\\s",       "name": "punctuation.definition.list" }
      ]
    },
    "link": {
      "patterns": [
        {
          "match": "(\\[)([^\\]]*)(\\])(\\()([^)]*)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.link.begin" },
            "2": { "name": "constant.other.reference.link" },
            "3": { "name": "punctuation.definition.link.end"   },
            "4": { "name": "punctuation.definition.metadata"   },
            "5": { "name": "markup.underline.link"             },
            "6": { "name": "punctuation.definition.metadata"   }
          }
        },
        {
          "match": "<(https?://[^>]+)>",
          "captures": { "1": { "name": "markup.underline.link" } }
        }
      ]
    },
    "image": {
      "match": "(\\!)\\[([^\\]]*)\\]\\(([^)]*)\\)",
      "captures": {
        "1": { "name": "punctuation.definition.image"          },
        "2": { "name": "string.other.link.title"               },
        "3": { "name": "markup.underline.link"                 }
      }
    },
    "bold-italic": {
      "match": "(\\*{3}|_{3})(?!\\s)(.+?)(?<!\\s)\\1",
      "captures": { "2": { "name": "markup.bold markup.italic" } }
    },
    "bold": {
      "patterns": [
        { "match": "(\\*\\*)(?!\\s)(.+?)(?<!\\s)\\1",  "captures": { "2": { "name": "markup.bold" } } },
        { "match": "(__) (?!\\s)(.+?)(?<!\\s)\\1",     "captures": { "2": { "name": "markup.bold" } } }
      ]
    },
    "italic": {
      "patterns": [
        { "match": "(\\*)(?!\\s)(.+?)(?<!\\s)\\1",     "captures": { "2": { "name": "markup.italic" } } },
        { "match": "(_)(?!\\s)(.+?)(?<!\\s)\\1",       "captures": { "2": { "name": "markup.italic" } } }
      ]
    },
    "strikethrough": {
      "match": "(~~)(?!\\s)(.+?)(?<!\\s)\\1",
      "captures": { "2": { "name": "markup.deleted" } }
    },
    "escape": {
      "match": "\\\\(?:[\\\\`*_{}\\[\\]()#+\\-.!<>|])",
      "name": "constant.character.escape"
    }
  }
}
